# ─── Variables de entorno — iniciosesion-service ──────────────────────
# Copia este archivo como .env y completa los valores.

# Firma JWT (genera una clave segura: openssl rand -hex 32)
JWT_SECRET=TU_SECRETO_AQUI

# Tiempo de expiración del token en milisegundos (opcional, default 86400000)
JWT_EXPIRATION_MS=86400000
