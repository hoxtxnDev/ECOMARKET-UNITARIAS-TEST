          "listen": "test",
          "script": {
            "exec": [
              "// 1. Validamos que el request haya sido exitoso (por ejemplo, código 200)\r",
              "if (pm.response.code === 200) {\r",
              "    // 2. Parseamos la respuesta JSON devuelta por tu API\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    // 3. Extraemos el token y lo guardamos en una variable global llamada \"token\"\r",
              "    // Nota: Cambia \"jsonData.token\" por la propiedad exacta que devuelva tu DTO o respuesta \r",
              "    // (por ejemplo: jsonData.access_token o jsonData.jwt)\r",
              "    pm.globals.set(\"token\", jsonData.token);\r",
              "    \r",
              "    console.log(\"Token guardado exitosamente en variable global.\");\r",
              "} else {\r",
              "    console.log(\"El login falló, no se guardó el token.\");\r",
              "}"
